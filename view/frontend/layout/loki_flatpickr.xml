<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="loki_base"/>

    <head>
        <css src="Loki_Flatpickr::css/flatpickr.min.css"/>
    </head>

    <body>
        <referenceContainer name="before.body.end">
            <block name="loki.script.flatpickr-loader"
                   template="Loki_Flatpickr::script/flatpickr-loader.phtml"
                   before="loki.script"/>
        </referenceContainer>

        <referenceBlock name="loki.script">
            <block name="loki.script.directive.flatpickr" template="Loki_Flatpickr::script/directive-flatpickr.phtml"/>
        </referenceBlock>

        <referenceBlock name="link-preload">
            <arguments>
                <argument name="scripts" xsi:type="array">
                    <item name="Loki_Flatpickr/css/flatpickr.min.css" xsi:type="boolean">false</item>
                </argument>
            </arguments>
        </referenceBlock>
    </body>
</page>
